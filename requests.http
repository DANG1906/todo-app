@baseUrl = http://localhost:3000/api/tasks
@id = 5

### GET: lấy danh sách
GET {{baseUrl}}

### POST: thêm task hợp lệ -> 201
POST {{baseUrl}}
Content-Type: application/json

{ "title": "Học REST Client" }

### POST: title rỗng -> 400
POST {{baseUrl}}
Content-Type: application/json

{ "title": "" }

### POST: toàn khoảng trắng -> 400
POST {{baseUrl}}
Content-Type: application/json

{ "title": "   " }

### POST: thiếu title -> 400
POST {{baseUrl}}
Content-Type: application/json

{}

### POST: title là số (sai kiểu) -> 400
POST {{baseUrl}}
Content-Type: application/json

{ "title": 12345 }

### POST: JSON sai cú pháp -> 400
POST {{baseUrl}}
Content-Type: application/json

{ "title": "abc"

### PATCH: đánh dấu hoàn thành -> 200
PATCH {{baseUrl}}/{{id}}
Content-Type: application/json

{ "status": 1 }

### PATCH: đổi title -> 200
PATCH {{baseUrl}}/{{id}}
Content-Type: application/json

{ "title": "Tên mới" }

### PATCH: status sai -> 400
PATCH {{baseUrl}}/{{id}}
Content-Type: application/json

{ "status": 5 }

### PATCH: body rỗng -> 400
PATCH {{baseUrl}}/{{id}}
Content-Type: application/json

{}

### PATCH: id không tồn tại -> 404
PATCH {{baseUrl}}/99999
Content-Type: application/json

{ "status": 1 }

### DELETE: xóa task -> 200 (lần 2 sẽ 404)
DELETE {{baseUrl}}/{{id}}

### DELETE: id sai định dạng -> 400
DELETE {{baseUrl}}/abc

### PATCH: id hex (sai định dạng) -> 400
PATCH {{baseUrl}}/0x10
Content-Type: application/json

{ "status": 1 }